# feedflowのサーバブロックです。CloudflareプロキシとAccessの背後で動きます。
# TLSはCloudflare Origin CA証明書で終端し、SSLモードFull(strict)に対応します。
# mTLSは廃止し、本人限定はCloudflare Accessとアプリログインで担保します。
# このファイルはterraformのtemplatefileでEC2上にだけ生成し配置します。

upstream feedflow_app {
    # composeのサービス名appで名前解決します。アプリは内部ネットワークの8080を待ち受けます。
    server app:8080;
    keepalive 16;
}

# Cloudflareエッジからの接続元IPを実クライアントIPへ復元します。
${real_ip_from_block}
real_ip_header CF-Connecting-IP;

# HTTPは443へ恒久リダイレクトします。
server {
    listen 80;
    listen [::]:80;
    server_name ${hostname};

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS終端です。証明書はCloudflare Origin CAのものを使います。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${hostname};

    ssl_certificate     /etc/feedflow/tls/server.crt;
    ssl_certificate_key /etc/feedflow/tls/server.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # セキュリティヘッダです。アプリ側でも付与しますが前段でも保証します。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        proxy_pass http://feedflow_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
    }
}
